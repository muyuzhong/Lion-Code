# 评测专用环境变量模板(复制为同目录 smoke.env 后填写,凭证不入库)。
# 权限要求:smoke.env 属主必须为运行用户且权限 600(run_smoke.sh 启动时
# 自动强制,无法保证时拒绝启动)。不要在任何聊天窗口/报告中粘贴这些值。

# ---- 模型 Provider(必填)----
# OpenAI 官方或任意 OpenAI-compatible 端点(如火山方舟)。
export OPENAI_API_KEY=
# 非官方端点才需要填写;与 LITELLM_API_BASE(DeepEval judge 端点)同源。
export OPENAI_BASE_URL=

# ---- 模型名(必填,写入 manifest.profile.model)----
# 例如 gpt-4o / deepseek-v3 / ep-2024xxxx 等该端点支持的模型 ID。
LION_MODEL=

# ---- DeepEval judge 模型(必填,独立于 agent 模型)----
# 固定 judge 模型,避免 agent 模型换代导致分数不可比;报告同时记录
# agent 模型、judge 模型与 Judge 指纹(judge 模型 + LITELLM_API_BASE)。
export DEEPEVAL_JUDGE_MODEL=

# ---- DeepEval 采样(可选,默认 3)----
# 每指标独立采样 N 次,score 取均值并记录范围;调小可省时省钱,
# 调大更抗单次漂移。
export DEEPEVAL_SAMPLES=

# ---- Opik 观测(必填)----
export OPIK_API_KEY=
export OPIK_WORKSPACE=