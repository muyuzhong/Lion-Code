{
  "name": "lion-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lion 桌面客户端（Electron 宿主 + Python sidecar）",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "preview": "electron-vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
